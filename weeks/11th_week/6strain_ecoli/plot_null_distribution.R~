library(ggplot2)
library(gridExtra)

clades <- c("b2", "d", "e", "f")
plot_list <- list()

summary_df <- read.csv("gin_mge_summary.csv")

for (c in clades) {
  file_path <- file.path(c, "pool_fur_markers", "shuffle_counts.txt")
  if (file.exists(file_path)) {
    shuffles <- read.table(file_path, header = FALSE)
    colnames(shuffles) <- c("count")
    
    obs_row <- subset(summary_df, dataset == c)
    obs_val <- if (nrow(obs_row) > 0) obs_row$observed[1] else 0
    p_val <- if (nrow(obs_row) > 0) obs_row$pvalue[1] else 1.0
    
    p <- ggplot(shuffles, aes(x = count)) +
      geom_histogram(binwidth = 1, fill = "#a6cee3", color = "#1f78b4", alpha = 0.7) +
      geom_vline(xintercept = obs_val, color = "red", linetype = "dashed", linewidth = 1) +
      annotate("text", x = obs_val, y = Inf, 
               label = paste0("Obs = ", obs_val, "\np = ", round(p_val, 3)), 
               vjust = 1.8, hjust = -0.1, color = "red", fontface = "bold", size = 3.5) +
      labs(title = paste0("Clade ", toupper(c)), x = "MGE Overlaps", y = "Count") +
      theme_minimal(base_size = 12)
    
    plot_list[[c]] <- p
  }
}

grid_plot <- marrangeGrob(plot_list, nrow = 2, ncol = 2, top = "MGE Overlap Null Distributions Across E. coli Clades")
ggsave("ecoli_mge_null_grid.png", grid_plot, width = 10, height = 8)
cat("Saved multi-panel plot to ecoli_mge_null_grid.png\n")
EOF

