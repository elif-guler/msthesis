process {
    withName: 'DOWNLOAD_DATABASES:DB_DOWNLOAD_VFDB' {
        memory = '28.GB'
    }
}
process {
    withName: 'EBIMETAGENOMICS:MOBILOMEANNOTATION:ISESCAN' {
        memory = '16.GB'
    }
}

process {
    withLabel: process_single {
        memory = 4.GB
    }
    withLabel: process_low {
        memory = 6.GB
    }
    withLabel: process_medium {
        memory = 12.GB
    }
    withLabel: process_high {
        cpus   = 6
        memory = 50.GB
    }
    withLabel: process_high_memory {
        memory = 24.GB
    }
}
