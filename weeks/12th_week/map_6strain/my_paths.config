}

process {
    withName: '.*ISESCAN.*' {
        memory = { 64.GB * task.attempt }
        cpus   = 8
        errorStrategy = { task.exitStatus in [137, 140, 1] ? 'retry' : 'finish' }
        maxRetries    = 2
    }
}