    icefinder_prokka_uniprot_db  = "/home/elif/msthesis/weeks/12th_week/map_6strain/dbs/icefinder2/icf2_dbs/icefinder_prokka_uniprot"

    // PATHOFACT2
    pathofact_models             = "/home/elif/msthesis/weeks/12th_week/map_6strain/dbs/pathofact"
